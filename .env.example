# --- Postgres ---
POSTGRES_USER=nha
POSTGRES_PASSWORD=nha_password
POSTGRES_DB=narrative_hunter
DATABASE_URL=postgresql+psycopg2://nha:nha_password@postgres:5432/narrative_hunter

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Discovery collectors ---
# Chains to poll for newly launched pools (GeckoTerminal network slugs)
DISCOVERY_NETWORKS=solana,eth,base
# How often (seconds) the discovery task runs
DISCOVERY_INTERVAL_SECONDS=120
# How often already-known coins get a fresh price/liquidity/volume check,
# independent of the new_pools discovery feed - see
# DiscoveryService.refresh_existing_prices() docstring for why this matters
# (without it, trend detection can never mature past a coin's first hour).
PRICE_REFRESH_INTERVAL_SECONDS=600
PRICE_REFRESH_RECHECK_HOURS=2
# Now runs on its own schedule, decoupled from discovery - 150 coins per
# cycle at the shared ~2.2s GeckoTerminal throttle needs real headroom.
SOCIAL_REENRICHMENT_INTERVAL_SECONDS=600
# How often (seconds) the risk-check (rug detection) task runs
RISK_INTERVAL_SECONDS=150
# How often (seconds) the trend-detection task runs
TREND_INTERVAL_SECONDS=160
# How often (seconds) the scoring task re-scores tracked coins
SCORING_INTERVAL_SECONDS=180

# --- Scoring weights (the full MODULE 8 spec, out of 100: Liquidity 10 / Trend 15 /
# Wallets 20 / Narrative 25 / Community 20 / Risk -20. ScoringService weight-averages
# whichever of liquidity/trend/wallet/narrative/community are available per coin,
# so these ratios hold regardless of which subset has data. ---
WEIGHT_LIQUIDITY=0.10
WEIGHT_TREND=0.15
WEIGHT_WALLET=0.20
WEIGHT_NARRATIVE=0.25
WEIGHT_COMMUNITY=0.20
# Subtractive penalty weight applied to risk_score (0-100), not part of the pool above
WEIGHT_RISK_PENALTY=0.20

# --- MODULE 9: Alerts ---
ALERT_INTERVAL_SECONDS=90
# Fires once when overall_score crosses from below to at/above this
ALERT_OVERALL_SCORE_THRESHOLD=70
# Fires when risk_score moves by at least this many points between two consecutive scoring cycles
ALERT_RISK_SCORE_CHANGE_THRESHOLD=20
# Skip overall/narrative/community threshold alerts if risk_score is
# confirmed at or above this - see alert_service.py docstring for the real
# user data (~27% of alerts were already-rugged coins) that prompted this.
ALERT_RISK_GATE_MAX=60
# Skip overall/narrative/community threshold alerts if liquidity is below
# this - real user feedback: alerts were firing for negligible-liquidity
# coins that crossed the score threshold on other signals alone. This is
# about LIQUIDITY/scale, not price-per-token - a coin can have a tiny
# per-token price and still be a real, liquid opportunity.
ALERT_MIN_LIQUIDITY_USD=10000
# When true, suppresses risk-INCREASING alerts specifically while keeping
# risk-decreasing ones and every other alert type (which are all
# inherently positive signals by construction).
ALERT_POSITIVE_ONLY=true
# Alerts older than this are permanently deleted (a genuine cleanup, not a
# soft-hide) - 30 days is deliberately generous, since real alert history
# has real diagnostic value for a while after it's created.
ALERT_RETENTION_DAYS=30
ALERT_CLEANUP_INTERVAL_SECONDS=86400

# Each channel below is optional - leave blank to skip it. Alerts are still
# recorded in the database (visible via /api/alerts) even with zero channels configured.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- MODULE 3: Wallet Intelligence (EVM chains only - eth, base) ---
# Free key from https://etherscan.io/apis (unified V2 API, works across eth/base/etc).
# Leave blank to skip wallet intelligence entirely - no data is faked.
ETHERSCAN_API_KEY=
WALLET_INTERVAL_SECONDS=200
WALLET_EARLY_ENTRY_WINDOW_MINUTES=60
WALLET_STRONG_REPUTATION_THRESHOLD=65
WALLET_ACCUMULATION_MIN_STRONG_WALLETS=3
WALLET_ACCUMULATION_LOOKBACK_HOURS=24
WALLET_ACCUMULATION_ALERT_COOLDOWN_HOURS=6

# --- MODULE 5: Rug Detection extras (sniper clusters + repeat deployers) ---
# Sniper cluster: flag when this many distinct wallets bought within this many seconds of launch
SNIPER_CLUSTER_WINDOW_SECONDS=60
SNIPER_CLUSTER_MIN_WALLETS=5
# Repeat deployer: flag when a creator address has deployed at least this many OTHER tracked coins
REPEAT_DEPLOYER_MIN_OTHER_COINS=2

# --- MODULE 9: Whale entry alert (EVM only, uses wallet_transactions + nearest price snapshot) ---
WHALE_ENTRY_USD_THRESHOLD=10000
WHALE_ENTRY_LOOKBACK_HOURS=6
WHALE_ENTRY_ALERT_COOLDOWN_HOURS=6

# --- MODULE 2: Narrative Scanner (each source independently optional) ---
# Default is deliberately conservative (2 hours) - every cycle that finds
# posts triggers a paid Claude API call per coin. See narrative_scanner_service.py
# and config.py for the full cost-safety explanation.
NARRATIVE_INTERVAL_SECONDS=7200
# Hard cap on coins analyzed by Claude per cycle (prioritizes highest-liquidity
# coins first) - this is what actually bounds your Anthropic bill. Worst-case
# monthly spend = NARRATIVE_MAX_COINS_PER_CYCLE * cycles_per_month * cost_per_call.
NARRATIVE_MAX_COINS_PER_CYCLE=15
# Only coins above this liquidity get scanned for narrative content at all
NARRATIVE_MIN_LIQUIDITY_USD=5000
# Bounded re-check for FREE-source scanning (Telegram/RSS) - separate from
# NARRATIVE_MAX_COINS_PER_CYCLE, which now applies only to the paid AI
# analysis step, not to free-source collection.
NARRATIVE_RECHECK_HOURS=6
# Separate from the recheck cadence above - how far back to look for
# ALREADY-COLLECTED posts (e.g. from YouTube) when feeding the AI.
# Real bug found in production: coins with confirmed existing YouTube
# posts still showed 0 AI analyses every cycle, since the scan only
# looked at what it could fetch live in that same moment.
NARRATIVE_EXISTING_POST_LOOKBACK_HOURS=24
# Reddit: OAuth2 app credentials. Self-service creation was closed Nov 2025 -
# see app/collectors/reddit.py docstring. Leave blank to skip.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NarrativeHunterAI/0.1 (contact: set-your-own)
# CryptoPanic: free Developer plan discontinued April 2026, needs a paid/trial token now.
CRYPTOPANIC_API_TOKEN=
# No setting needed for the free bonus source: CryptoPanic's general public
# RSS feed (cryptopanic.com/news/rss) runs automatically with no key at all,
# fetched once per narrative cycle and matched against each coin's symbol/name.

# --- MODULE 4: Community Intelligence bonus source (optional) ---
# Free tier: 4 requests/minute. This is a bulk snapshot endpoint (thousands
# of coins per request), so the limit governs refresh cadence, not which
# individual coins get checked - see collectors/lunarcrush.py.
# Used as a fallback when our own post-collection finds nothing (fills real
# coverage gaps for established coins), and blended in when it does.
LUNARCRUSH_API_KEY=
# X/Twitter: pay-per-use only since Feb 2026, no free tier.
TWITTER_BEARER_TOKEN=

# --- MODULE 7: Narrative AI ---
# Get a key at https://console.anthropic.com. Leave blank to skip narrative
# analysis entirely - collected posts are still stored, just not analyzed.
ANTHROPIC_API_KEY=
# Haiku 4.5, not Sonnet - this is a bounded classification task (scoring
# social posts for narrative virality), and Haiku is roughly half the
# cost on both input/output per Anthropic's real, current pricing page.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ALERT_NARRATIVE_SCORE_THRESHOLD=70

# --- MODULE 4: Community Intelligence (analyzes SocialPost data MODULE 2 already collects) ---
# No separate API keys needed - reuses whatever Reddit/CryptoPanic/X collected above,
# plus an extra Reddit call for subscriber counts if REDDIT_CLIENT_ID/SECRET are set.
COMMUNITY_INTERVAL_SECONDS=320
COMMUNITY_LOOKBACK_DAYS=7
ALERT_COMMUNITY_SCORE_THRESHOLD=70

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Frontend ---
# Must be reachable from the user's BROWSER, not just inside Docker's network -
# that's why this is localhost:8000 (the host-mapped API port), not http://api:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Paper Trading (simulated, no real money/wallet) ---
PAPER_TRADING_INTERVAL_SECONDS=120
# Lowered from 70 to 65 to generate real trades for win-rate testing,
# since 70 produced zero trades across a full overnight run.
# Lowered from 65 to 64 - 65 still produced zero trades after 5+ days,
# and 64 occasionally shows up on the dashboard.
PAPER_TRADING_ENTRY_SCORE_THRESHOLD=64
# Real gap found and closed: before these existed, take-profit was the
# ONLY exit condition anywhere in the code - a losing or flat position
# stayed "open" forever, meaning win_rate_pct was structurally
# guaranteed to trend toward 100% (every trade that COULD close was by
# definition a win).
# Widened to a symmetric -50/+50 at the user's request. Genuine tradeoff:
# at £50 position size, max modeled loss per trade goes from £10 to £25.
PAPER_TRADING_STOP_LOSS_PCT=-50
PAPER_TRADING_MAX_HOLD_HOURS=72
PAPER_TRADING_RISK_GATE_MAX=60
PAPER_TRADING_EXIT_GAIN_PCT=50
PAPER_TRADING_POSITION_SIZE_GBP=50

# Bounded re-check windows (see risk_service.py / wallet_service.py docstrings
# for why this matters at real scale - a throttled full re-scan of every
# active coin every cycle stops keeping up once you have 1000+ coins)
RISK_RECHECK_HOURS=6
WALLET_RECHECK_HOURS=6

# --- MODULE 3 extension: Solana Wallet Intelligence (optional) ---
# Free tier: 2,500 requests/month at solanatracker.io - verified via their
# ACTUAL pricing page (an earlier version of this cited 10,000/month from
# a search result, which was wrong).
# own pricing table. Budget math worked out in config.py: these defaults
# target ~2,400 requests/month, safely under the real limit. Uses real per-token
# PnL data (see solana_wallet_service.py docstring for how this differs
# from the EVM wallet module - a real but imperfect signal, documented
# honestly).
SOLANATRACKER_API_KEY=

# --- MODULE 2 extension: YouTube narrative scanning (optional) ---
# Free tier: 10,000 quota units/day, no card required - verified across
# multiple sources. search.list costs 100 units/call (the dominant cost);
# defaults target ~9,000/day, a real ~10% margin under the cap. Feeds the
# same SocialPost/community_score/narrative_score pipeline Telegram and
# RSS already feed.
YOUTUBE_API_KEY=

# --- MODULE 5 extension: RugCheck.xyz Solana-specific risk detection (optional) ---
# Genuinely optional - research found conflicting info on whether read
# endpoints even require a key at all; the collector works either way.
# Used specifically as a fallback when GoPlus has no data for a Solana
# coin, a real, repeatedly-observed gap - not a full GoPlus replacement.
RUGCHECK_API_KEY=

# --- Pool migration detector (MODULE 1 extension) ---
# Closes a real gap: discovery/refresh only ever look at the ONE pool
# address a coin was first found on. A coin's real trading can move to
# a different, healthier pool later (a pump.fun graduation being the
# clearest example) - this periodically re-checks thin/stale coins
# against every pool GeckoTerminal reports for that token contract.
POOL_MIGRATION_INTERVAL_SECONDS=3600
POOL_MIGRATION_MAX_COINS_PER_CYCLE=20
POOL_MIGRATION_STALE_LIQUIDITY_THRESHOLD_USD=5000
POOL_MIGRATION_IMPROVEMENT_MULTIPLE=3.0
POOL_MIGRATION_RECHECK_HOURS=12
